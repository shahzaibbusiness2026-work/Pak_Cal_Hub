# --- Supabase CMS backend (Auth + Storage + blog/news/articles) ---
# Create a project at https://supabase.com/dashboard, then run
# supabase/migrations/0001_cms.sql and supabase/seed.sql in the SQL editor.
# The app builds and runs fine without these (blog shows "coming soon",
# CMS API routes return 503 with a setup hint).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
# Server-only secret. NEVER prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Comma-separated owner emails allowed into /admin (recommended).
# Any authenticated user is treated as admin when this is empty.
ADMIN_EMAILS="you@example.com"
